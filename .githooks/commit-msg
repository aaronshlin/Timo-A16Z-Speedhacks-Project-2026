#!/bin/sh
# Strip AI attribution trailers and "generated with" lines from commit messages.
f="$1"
tmp="$f.tmp"
grep -viE 'co-authored-by:.*(claude|cursor|anthropic|copilot|openai|codex|gemini|cursoragent)|cursoragent@cursor\.com|generated (with|by) .*(claude|cursor|copilot|ai)|made with .*(claude|cursor)' "$f" > "$tmp" || true
mv "$tmp" "$f"
if grep -qiE 'cursoragent@cursor\.com|co-authored-by:.*(claude|cursor|anthropic|copilot|openai|codex|gemini)' "$f"; then
  echo "commit-msg: blocked an AI attribution trailer" >&2
  exit 1
fi
