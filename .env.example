USE_MOCKS=1
NOW_OVERRIDE=
POLLER_ENABLED=0
DEMO_PHONE=+1XXXXXXXXXX
ANTHROPIC_API_KEY=
DIAL_API_KEY=
DIAL_NUMBER=+17816286441
DIAL_FROM_NUMBER_ID=
TIMO_NUMBER=+1XXXXXXXXXX
USER_NUMBER=+1XXXXXXXXXX
USER_NUMBER_ID=
DIAL_SMS_WEBHOOK_SECRET=
MOCK_DIAL=1
# Defaults to token.json in the repo root. Only read when USE_MOCKS=0.
GOOGLE_TOKEN_PATH=
TODOIST_TOKEN=
LLM_MODEL=claude-haiku-5-5

# Read/call readiness is independent. Real reads never enable external writes.
LIVE_CALLS_ENABLED=0
CALL_OPT_IN=0
CALL_TRIGGER_TOKEN=
CALENDAR_TRIGGER_TOKEN=
DIAL_FROM_NUMBER_ID=cmv44iugl00mt0ftbpptzmudz
DIAL_WEBHOOK_SECRET=
CALL_SESSION_LIMIT=1
CALL_COOLDOWN_SECONDS=300
CALL_STATE_PATH=
CALL_ENGINE_STATE_PATH=
GOOGLE_CALENDAR_IDS=["primary"]
CALENDAR_ACTIVE_START_HOUR=9
CALENDAR_ACTIVE_END_HOUR=18
CALENDAR_BUFFER_MINUTES=3
RECEIPT_MODE=dashboard

# Two-agent demo: Timo is DIAL_FROM_NUMBER_ID (DIAL_NUMBER is its E.164); the second Dial
# number plays the user. DEMO_PHONE must be that second number's E.164.
DIAL_USER_NUMBER_ID=
SMS_ENABLED=0
MCP_TOKEN=

# Optional real-clock demo calling window; Google events still determine availability.
CALL_DEMO_WINDOW_START=
CALL_DEMO_WINDOW_END=

# Explicit local mock-calendar demo; default never permits real calls.
MOCK_CALENDAR_PATH=
ALLOW_DEMO_CALENDAR_CALLS=false
